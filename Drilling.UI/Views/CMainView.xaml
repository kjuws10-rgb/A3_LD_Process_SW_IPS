                                <Border Grid.Row="0" Style="{StaticResource MainOpticSectionCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="LASER CURRENT"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <ItemsControl Grid.Row="1"
                                                      Margin="0,8,0,0"
                                                      ItemsSource="{Binding CurrentScreen.MainOperating.OpticHeadParameters}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="2" Columns="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource MainOpticHeadMiniCard}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Text="{Binding Head}"
                                                                       Foreground="{DynamicResource AccentTextBrush}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Left" />
                                                            <Grid Grid.Row="1"
                                                                  Margin="0,6,0,0"
                                                                  VerticalAlignment="Center">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="*" />
                                                                    <RowDefinition Height="*" />
                                                                    <RowDefinition Height="*" />
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="64" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Text="POWER"
                                                                           Style="{StaticResource MainOpticSubValueText}" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding LaserPower}"
                                                                           Foreground="{Binding LaserPowerBrush}"
                                                                           Style="{StaticResource MainOpticCompactValueText}" />
                                                                <TextBlock Grid.Row="1"
                                                                           Text="SHUTTER"
                                                                           Style="{StaticResource MainOpticSubValueText}" />
                                                                <TextBlock Grid.Row="1"
                                                                           Grid.Column="1"
                                                                           Text="{Binding LaserShutter}"
                                                                           Foreground="{Binding LaserShutterBrush}"
                                                                           Style="{StaticResource MainOpticCompactValueText}" />
                                                                <TextBlock Grid.Row="2"
                                                                           Text="GATE"
                                                                           Style="{StaticResource MainOpticSubValueText}" />
                                                                <TextBlock Grid.Row="2"
                                                                           Grid.Column="1"
                                                                           Text="{Binding LaserGate}"
                                                                           Foreground="{Binding LaserGateBrush}"
                                                                           Style="{StaticResource MainOpticCompactValueText}" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource MainOpticSectionCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="ATT POSITION"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <ItemsControl Grid.Row="1"
                                                      Margin="0,8,0,0"
                                                      ItemsSource="{Binding CurrentScreen.MainOperating.OpticHeadParameters}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="2" Columns="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource MainOpticHeadMiniCard}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Text="{Binding Head}"
                                                                       Foreground="{DynamicResource AccentTextBrush}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Left" />
                                                            <Grid Grid.Row="1"
                                                                  Margin="0,8,0,0"
                                                                  VerticalAlignment="Center">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="*" />
                                                                    <RowDefinition Height="*" />
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="32" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Text="CUR"
                                                                           Style="{StaticResource MainOpticSubValueText}" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding AttenuatorCurrent}"
                                                                           Style="{StaticResource MainOpticCompactValueText}"
                                                                           Foreground="{Binding AttenuatorStateBrush}" />
                                                                <TextBlock Grid.Row="1"
                                                                           Text="TGT"
                                                                           Style="{StaticResource MainOpticSubValueText}" />
                                                                <TextBlock Grid.Row="1"
                                                                           Grid.Column="1"
                                                                           Text="{Binding AttenuatorTarget}"
                                                                           Style="{StaticResource MainOpticCompactValueText}"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2" Style="{StaticResource MainOpticSectionCard}" Margin="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="BET"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <ItemsControl Grid.Row="1"
                                                      Margin="0,8,0,0"
                                                      ItemsSource="{Binding CurrentScreen.MainOperating.OpticHeadParameters}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="2" Columns="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource MainOpticHeadMiniCard}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Text="{Binding Head}"
                                                                       Foreground="{DynamicResource AccentTextBrush}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Left" />
                                                            <Grid Grid.Row="1"
                                                                  Margin="0,6,0,0"
                                                                  VerticalAlignment="Center">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="*" />
                                                                    <RowDefinition Height="*" />
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="34" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="1"
                                                                           Text="CUR"
                                                                           Style="{StaticResource MainOpticSubValueText}" />
                                                                <TextBlock Grid.Column="2"
                                                                           Text="TGT"
                                                                           Style="{StaticResource MainOpticSubValueText}" />
                                                                <TextBlock Grid.Row="1"
                                                                           Text="MAG"
                                                                           Style="{StaticResource MainOpticSubValueText}" />
                                                                <TextBlock Grid.Row="1"
                                                                           Grid.Column="1"
                                                                           Text="{Binding BetMagnificationCurrentStep}"
                                                                           Style="{StaticResource MainOpticCompactValueText}"
                                                                           Foreground="{Binding BetStateBrush}" />
                                                                <TextBlock Grid.Row="1"
                                                                           Grid.Column="2"
                                                                           Text="{Binding BetMagnificationTargetStep}"
                                                                           Style="{StaticResource MainOpticCompactValueText}"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                <TextBlock Grid.Row="2"
                                                                           Text="DIV"
                                                                           Style="{StaticResource MainOpticSubValueText}" />
                                                                <TextBlock Grid.Row="2"
                                                                           Grid.Column="1"
                                                                           Text="{Binding BetDivergenceCurrentStep}"
                                                                           Style="{StaticResource MainOpticCompactValueText}"
                                                                           Foreground="{Binding BetStateBrush}" />
                                                                <TextBlock Grid.Row="2"
                                                                           Grid.Column="2"
                                                                           Text="{Binding BetDivergenceTargetStep}"
                                                                           Style="{StaticResource MainOpticCompactValueText}"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <DataGrid ItemsSource="{Binding CurrentScreen.MainOperating.ScannerStatusItems}"
                                  Visibility="{Binding CurrentScreen.MainOperating.ScannerStatusVisibility}"
                                  IsReadOnly="True"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Style="{StaticResource MainDataGrid}"
                                  FontSize="10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Head" Binding="{Binding Head}" Width="48" ElementStyle="{StaticResource MainGridText}" />
                                <DataGridTextColumn Header="A1" Binding="{Binding Automation}" Width="42" ElementStyle="{StaticResource MainGridText}" />
                                <DataGridTextColumn Header="Axis" Binding="{Binding Axis}" Width="42" ElementStyle="{StaticResource MainGridText}" />
                                <DataGridTextColumn Header="No." Binding="{Binding AxisNo}" Width="38" ElementStyle="{StaticResource MainGridText}" />
                                <DataGridTemplateColumn Header="Able" Width="62">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Able}"
                                                       Foreground="{Binding AbleBrush}"
                                                       FontWeight="SemiBold"
                                                       Style="{StaticResource MainGridText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="72" ElementStyle="{StaticResource MainGridText}" />
                                <DataGridTextColumn Header="Aux" Binding="{Binding AuxFeedback}" Width="72" ElementStyle="{StaticResource MainGridText}" />
                                <DataGridTemplateColumn Header="Home" Width="58">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Home}"
                                                       Foreground="{Binding HomeBrush}"
                                                       FontWeight="SemiBold"
                                                       Style="{StaticResource MainGridText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Error" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Error}"
                                                       Foreground="{Binding ErrorBrush}"
                                                       FontWeight="SemiBold"
                                                       Style="{StaticResource MainGridText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="620" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Automation Script Status" Style="{StaticResource PanelTitle}" />
                    <TextBlock DockPanel.Dock="Top"
                               Text="Lifecycle"
                               Style="{StaticResource MainValueText}"
                               Margin="0,12,0,8" />
                    <Border DockPanel.Dock="Top"
                            Padding="8"
                            BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1"
                            Background="{DynamicResource PanelAltBackgroundBrush}">
                        <ItemsControl ItemsSource="{Binding CurrentScreen.MainOperating.LifecycleItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center">
                                        <Ellipse Width="14"
                                                 Height="14"
                                                 Stroke="{Binding StateBrush}"
                                                 StrokeThickness="3"
                                                 Fill="{DynamicResource PanelBackgroundBrush}" />
                                        <TextBlock Text="{Binding Name}"
                                                   Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="9"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Value}"
                                                   Foreground="{Binding StateBrush}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <ItemsControl Margin="0,10,0,0"
                                  ItemsSource="{Binding CurrentScreen.MainOperating.ScriptTaskStatusItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="2" Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="3"
                                        Padding="7"
                                        Background="{DynamicResource PanelAltBackgroundBrush}"
                                        BorderBrush="{DynamicResource PanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Task}"
                                                       Foreground="{DynamicResource AccentTextBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Head}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold" />
                                        </Grid>
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,6,0,0"
                                                   Text="{Binding State}"
                                                   Foreground="{Binding StateBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Row="2"
                                                    Margin="0,6,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ControllerTaskText}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding FileText}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="9"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Grid Grid.Row="3" Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DetailText}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="8"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding PointText}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="8"
                                                       FontWeight="SemiBold" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Margin="12,0,6,0" Style="{StaticResource PanelBorder}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Inspection Status" Style="{StaticResource PanelTitle}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CurrentScreen.MainOperating.InspectionSummary}"
                                   Foreground="{DynamicResource ButtonPrimaryBorderBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="10,5"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                Background="{DynamicResource PanelAltBackgroundBrush}">

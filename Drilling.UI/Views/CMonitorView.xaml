                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" MinWidth="140" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource PanelBorder}">

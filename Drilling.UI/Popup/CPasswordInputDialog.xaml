<Window x:Class="Drilling.UI.Popup.CPasswordInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password Input"
        Width="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        KeyDown="WindowKeyDown"
        Background="{DynamicResource GridBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="KeyButton" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource HeaderNavPressedBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Padding="20" Background="{DynamicResource ButtonSecondaryBrush}" BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="PM Password" FontSize="18" FontWeight="SemiBold" />
            <PasswordBox x:Name="PasswordInput" Grid.Row="1" Height="52" Margin="0,12,0,8" Padding="12,8" FontSize="21" VerticalContentAlignment="Center" />
            <TextBlock Grid.Row="2" Text="Password input" Margin="2,0,0,10" Foreground="{DynamicResource TextSecondaryBrush}" />
            <UniformGrid x:Name="KeyGrid" Grid.Row="3" Columns="10" />
            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="SPACE" Click="SpaceClick" Style="{StaticResource KeyButton}" />
                <Button Grid.Column="1" Content="BACK" Click="BackClick" Style="{StaticResource KeyButton}" />
                <Button Grid.Column="2" Content="CLEAR" Click="ClearClick" Style="{StaticResource KeyButton}" />
                <Button Grid.Column="3" Content="CANCEL" Click="CancelClick" Style="{StaticResource KeyButton}" />
                <Button Grid.Column="4" Content="OK" Click="OkClick" Style="{StaticResource KeyButton}" Background="{DynamicResource ButtonSuccessBrush}" BorderBrush="{DynamicResource StatusReadyBrush}" />
            </Grid>
        </Grid>
    </Border>
</Window>

                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding StateBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalPoints}" Width="90" />
                                <DataGridTextColumn Header="Done" Binding="{Binding CompletedPoints}" Width="90" />
                                <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding ResultBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

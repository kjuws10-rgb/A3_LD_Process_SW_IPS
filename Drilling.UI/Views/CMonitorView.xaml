                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch" />
                                    <ItemsControl ItemsSource="{Binding CurrentScreen.Monitor.CoordinateCellPreviewLabels}"
                                                  Style="{StaticResource CellPreviewLabelItemsControl}"
                                                  ItemContainerStyle="{StaticResource CoordinatePreviewFillItemContainer}"

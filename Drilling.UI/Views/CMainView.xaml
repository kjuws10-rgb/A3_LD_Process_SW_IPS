                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </Border>
                        <Border Grid.Column="1"
                                Margin="8,0,0,0"
                                Padding="10,5"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                Background="{DynamicResource PanelAltBackgroundBrush}"
                                Visibility="{Binding CurrentScreen.MainOperating.InspectionRuleVisibility}">
                            <TextBlock Text="{Binding CurrentScreen.MainOperating.InspectionRuleText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <DataGrid ItemsSource="{Binding CurrentScreen.MainOperating.InspectionStatusItems}"
                              IsReadOnly="True"
                              Style="{StaticResource MainDataGrid}"
                              FontSize="11"
                              HorizontalScrollBarVisibility="Disabled">

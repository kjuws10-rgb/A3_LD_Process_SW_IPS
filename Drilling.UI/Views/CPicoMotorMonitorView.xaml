<UserControl x:Class="Drilling.UI.Views.CPicoMotorMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewMouseLeftButtonDown="PicoMonitorPreviewMouseLeftButtonDown"
             FontFamily="Segoe UI">
    <UserControl.Resources>

        <Style x:Key="MonitorSmallText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="MonitorValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MonitorTabButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="#101923" />
            <Setter Property="BorderBrush" Value="#344251" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#DDE6EF" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonitorActionButton" TargetType="Button">
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Foreground" Value="#F3F6FA" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PicoSetCommandButton"
               TargetType="Button"
               BasedOn="{StaticResource MonitorActionButton}">
            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextOnColorBrush}" />
        </Style>

        <Style x:Key="IoCommandButton" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Width" Value="66" />
            <Setter Property="Foreground" Value="#F3F6FA" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonitorInputCell" TargetType="Border">
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="0,4" />
        </Style>

        <Style x:Key="PicoEditableCell"
               TargetType="Border"
               BasedOn="{StaticResource MonitorInputCell}">
            <Setter Property="Cursor" Value="Arrow" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PicoEditableTextBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource ButtonPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <EventSetter Event="LostKeyboardFocus" Handler="PicoValueEditorLostKeyboardFocus" />
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="False">
                    <Setter Property="Cursor" Value="IBeam" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PicoInputButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputBorder" Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" /><Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" /><Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="InputBorder" Property="Background" Value="{DynamicResource HeaderNavPressedBackgroundBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PicoButtonContentTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0"
                         Width="14"
                         Height="14">
                    <Path Data="{Binding IconGeometry}"
                          Stroke="#F3F6FA"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Fill="Transparent" />
                </Viewbox>
                <TextBlock Grid.Column="1"
                           Text="{Binding Label}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PicoWideButtonContentTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0"
                         Width="16"
                         Height="16">
                    <Path Data="{Binding IconGeometry}"
                          Stroke="#F3F6FA"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Fill="Transparent" />
                </Viewbox>
                <TextBlock Grid.Column="1"
                           Text="{Binding Label}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

            <!-- Pico Motor -->
            <Grid Visibility="{Binding CurrentScreen.Monitor.IsPicoMotor, Converter={StaticResource BooleanToVisibilityConverter}}"
                  ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="31*" />
                    <ColumnDefinition Width="46*" />
                    <ColumnDefinition Width="23*" />
                </Grid.ColumnDefinitions>

                <!-- Pico Motor / Status -->
                <Border Grid.Column="0"
                        Style="{StaticResource PanelBorder}"
                        Margin="0,0,12,0"
                        ClipToBounds="True">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Pico Motor Status"
                                   Style="{StaticResource PanelTitle}"
                                   FontSize="18" />

                        <DataGrid ItemsSource="{Binding CurrentScreen.Monitor.StatusRows}"
                                  IsReadOnly="True"
                                  Style="{StaticResource PlainDataGrid}"
                                  FontSize="12"
                                  ColumnHeaderHeight="38"
                                  RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="140" />
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="95" />
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="48" />
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*" MinWidth="65" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Pico Motor / Operation -->
                <Border Grid.Column="1"
                        Style="{StaticResource PanelBorder}"
                        Margin="0,0,12,0"
                        ClipToBounds="True">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Pico Motor Operation"
                                   Style="{StaticResource PanelTitle}"
                                   FontSize="18" />

                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Stretch">
                        <Grid Margin="8,10,8,0"
                              MinHeight="650">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="84" />
                                <RowDefinition Height="104" />
                                <RowDefinition Height="220" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Operation / Connection -->
                            <ItemsControl Grid.Row="0"
                                          ItemsSource="{Binding CurrentScreen.Monitor.PicoConnectionButtons}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Height="58"
                                                Margin="5,0"
                                                Background="{Binding BackgroundBrush}"
                                                BorderBrush="{Binding BorderBrush}"
                                                Command="{Binding DataContext.CurrentScreen.Monitor.ExecuteOperationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MonitorActionButton}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="34" />
                                                </Grid.ColumnDefinitions>
                                                <Viewbox Width="18" Height="18">
                                                    <Path Data="{Binding IconGeometry}"
                                                          Stroke="#F3F6FA"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Fill="Transparent" />
                                                </Viewbox>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Label}"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Operation / Motor Select -->
                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="44" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Motor Select"
                                           Style="{StaticResource MonitorValueText}"
                                           VerticalAlignment="Center" />

                                <ItemsControl Grid.Row="1"
                                              ItemsSource="{Binding CurrentScreen.Monitor.PicoMotorSelectButtons}"
                                              Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Height="36"
                                                    Margin="3,0"
                                                    Background="{Binding BackgroundBrush}"
                                                    BorderBrush="{Binding BorderBrush}"
                                                    Command="{Binding DataContext.CurrentScreen.Monitor.ExecuteOperationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MonitorActionButton}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="18" />
                                                    </Grid.ColumnDefinitions>
                                                    <Viewbox Width="14" Height="14">
                                                        <Path Data="{Binding IconGeometry}"
                                                              Stroke="#F3F6FA"
                                                              StrokeThickness="2"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              Fill="Transparent" />
                                                    </Viewbox>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Label}"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               TextAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!-- Operation / Velocity Setting -->
                            <Border Grid.Row="2"
                        Margin="0,12,0,0"
                        BorderBrush="#273241"
                        BorderThickness="0,1,0,0">
                                <Grid Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="40" />
                                        <RowDefinition Height="40" />
                                        <RowDefinition Height="40" />
                                        <RowDefinition Height="40" />
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="155" />
                                        <ColumnDefinition Width="105" />
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="5"
                                   Text="Velocity Setting"
                                   Style="{StaticResource MonitorValueText}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Current Velocity"
                                   Style="{StaticResource MonitorSmallText}"
                                   VerticalAlignment="Center" />
                                    <Border Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource MonitorInputCell}">
                                        <TextBlock Text="{Binding CurrentScreen.Monitor.OperationFields[0].Value}"
                                       Style="{StaticResource MonitorValueText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   Text="mm/sec"
                                   Style="{StaticResource MonitorSmallText}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />

                                    <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Set Velocity"
                                   Style="{StaticResource MonitorSmallText}"
                                   VerticalAlignment="Center" />
                                    <Button Grid.Row="2" Grid.Column="1"
                                            Content="{Binding CurrentScreen.Monitor.OperationFields[1].Value}"
                                            Tag="{Binding CurrentScreen.Monitor.OperationFields[1]}"
                                            Click="OpenPicoValueInput"
                                            Style="{StaticResource PicoInputButton}" />
                                    <TextBlock Grid.Row="2"
                                   Grid.Column="2"
                                   Text="mm/sec"

                                   Style="{StaticResource MonitorSmallText}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                                    <Button Grid.Row="2"
                                Grid.Column="3"
                                Command="{Binding CurrentScreen.Monitor.ExecuteOperationCommand}"
                                CommandParameter="PICO_SET_VEL"
                                Style="{StaticResource PicoSetCommandButton}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0"
                                      Data="M5,4 H17 L20,7 V20 H4 V4 Z M8,4 V10 H16 V4 M8,17 H16"
                                      Stroke="{DynamicResource ButtonTextOnColorBrush}"
                                      StrokeThickness="2"
                                      Fill="Transparent"
                                      Width="12"
                                      Height="12"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                           Text="SET VEL"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>

                                    <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="Current Acceleration"
                                   Style="{StaticResource MonitorSmallText}"
                                   VerticalAlignment="Center" />
                                    <Border Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource MonitorInputCell}">
                                        <TextBlock Text="{Binding CurrentScreen.Monitor.OperationFields[2].Value}"
                                       Style="{StaticResource MonitorValueText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Row="3"
                                   Grid.Column="2"
                                   Text="msec"
                                   Style="{StaticResource MonitorSmallText}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />

                                    <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Text="Set Acceleration"
                                   Style="{StaticResource MonitorSmallText}"
                                   VerticalAlignment="Center" />
                                    <Button Grid.Row="4" Grid.Column="1"
                                            Content="{Binding CurrentScreen.Monitor.OperationFields[3].Value}"
                                            Tag="{Binding CurrentScreen.Monitor.OperationFields[3]}"
                                            Click="OpenPicoValueInput"
                                            Style="{StaticResource PicoInputButton}" />
                                    <TextBlock Grid.Row="4"
                                   Grid.Column="2"
                                   Text="msec"
                                   Style="{StaticResource MonitorSmallText}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                                    <Button Grid.Row="4"
                                Grid.Column="3"
                                Command="{Binding CurrentScreen.Monitor.ExecuteOperationCommand}"
                                CommandParameter="PICO_SET_ACC"
                                Style="{StaticResource PicoSetCommandButton}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0"
                                      Data="M5,4 H17 L20,7 V20 H4 V4 Z M8,4 V10 H16 V4 M8,17 H16"
                                      Stroke="{DynamicResource ButtonTextOnColorBrush}"
                                      StrokeThickness="2"
                                      Fill="Transparent"
                                      Width="12"
                                      Height="12"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                           Text="SET ACC"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Operation / Motion -->
                            <Border Grid.Row="3"
                        Margin="0,12,0,0"
                        BorderBrush="#273241"
                        BorderThickness="0,1,0,0">
                                <Grid Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                   Text="Motion"
                                   Style="{StaticResource MonitorValueText}"
                                   VerticalAlignment="Center" />

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="55*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="45*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="44" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="38" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="38" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="38" />
                                            </Grid.RowDefinitions>

                                            <ItemsControl Grid.Row="0"
                                                          ItemsSource="{Binding CurrentScreen.Monitor.PicoMotionStopButtons}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Height="40"
                                                                Margin="0,0,8,0"
                                                                Background="{Binding BackgroundBrush}"
                                                                BorderBrush="{Binding BorderBrush}"
                                                                Command="{Binding DataContext.CurrentScreen.Monitor.ExecuteOperationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="{Binding}"
                                                                ContentTemplate="{StaticResource PicoWideButtonContentTemplate}"
                                                                Style="{StaticResource MonitorActionButton}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <ItemsControl Grid.Row="2"
                                                          ItemsSource="{Binding CurrentScreen.Monitor.PicoMotionMoveButtons}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="2" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Height="36"
                                                                Margin="0,0,8,0"
                                                                Background="{Binding BackgroundBrush}"
                                                                BorderBrush="{Binding BorderBrush}"
                                                                Command="{Binding DataContext.CurrentScreen.Monitor.ExecuteOperationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="{Binding}"
                                                                ContentTemplate="{StaticResource PicoButtonContentTemplate}"
                                                                Style="{StaticResource MonitorActionButton}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <ItemsControl Grid.Row="4"
                                                          ItemsSource="{Binding CurrentScreen.Monitor.PicoMotionJogButtons}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="2" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Height="36"
                                                                Margin="0,0,8,0"
                                                                Background="{Binding BackgroundBrush}"
                                                                BorderBrush="{Binding BorderBrush}"
                                                                PreviewMouseDown="PicoJogButtonPreviewMouseDown"
                                                                PreviewMouseUp="PicoJogButtonPreviewMouseUp"
                                                                MouseLeave="PicoJogButtonMouseLeave"
                                                                Content="{Binding}"
                                                                ContentTemplate="{StaticResource PicoButtonContentTemplate}"
                                                                Style="{StaticResource MonitorActionButton}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <ItemsControl Grid.Row="6"
                                                          ItemsSource="{Binding CurrentScreen.Monitor.PicoMotionRelButtons}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="2" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Height="36"
                                                                Margin="0,0,8,0"
                                                                Background="{Binding BackgroundBrush}"

                                                                BorderBrush="{Binding BorderBrush}"
                                                                Command="{Binding DataContext.CurrentScreen.Monitor.ExecuteOperationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="{Binding}"
                                                                ContentTemplate="{StaticResource PicoButtonContentTemplate}"
                                                                Style="{StaticResource MonitorActionButton}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>

                                        <!-- Motion Values -->
                                        <Grid Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Top">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="38" />
                                                <RowDefinition Height="38" />
                                                <RowDefinition Height="38" />
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="95" />
                                                <ColumnDefinition Width="85" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="3"
                                           Text="Motion Value"
                                           Style="{StaticResource MonitorValueText}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Home Position"
                                           Style="{StaticResource MonitorSmallText}"
                                           VerticalAlignment="Center" />
                                            <Border Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource MonitorInputCell}">
                                                <TextBlock Text="{Binding CurrentScreen.Monitor.OperationFields[4].Value}"
                                                           Style="{StaticResource MonitorValueText}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Row="1"
                                           Grid.Column="2"
                                           Text="step"
                                           Style="{StaticResource MonitorSmallText}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />

                                            <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="Absolute Move"
                                           Style="{StaticResource MonitorSmallText}"
                                           VerticalAlignment="Center" />
                                            <Button Grid.Row="2" Grid.Column="1"
                                                    Content="{Binding CurrentScreen.Monitor.OperationFields[6].Value}"
                                                    Tag="{Binding CurrentScreen.Monitor.OperationFields[6]}"
                                                    Click="OpenPicoValueInput"
                                                    Style="{StaticResource PicoInputButton}" />
                                            <TextBlock Grid.Row="2"
                                           Grid.Column="2"
                                           Text="mm"
                                           Style="{StaticResource MonitorSmallText}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />

                                            <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Text="Relative Move"
                                           Style="{StaticResource MonitorSmallText}"
                                           VerticalAlignment="Center" />
                                            <Button Grid.Row="3" Grid.Column="1"
                                                    Content="{Binding CurrentScreen.Monitor.OperationFields[5].Value}"
                                                    Tag="{Binding CurrentScreen.Monitor.OperationFields[5]}"
                                                    Click="OpenPicoValueInput"
                                                    Style="{StaticResource PicoInputButton}" />
                                            <TextBlock Grid.Row="3"
                                           Grid.Column="2"
                                           Text="mm"
                                           Style="{StaticResource MonitorSmallText}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Pico Motor / Error and All Motor Move -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="320" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                Style="{StaticResource PanelBorder}"
                Margin="0,0,0,12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                           Text="Pico Motor Error"
                           Style="{StaticResource PanelTitle}"
                           FontSize="18" />

                            <DataGrid ItemsSource="{Binding CurrentScreen.Monitor.ParameterRows}"
                          IsReadOnly="True"
                          Style="{StaticResource PlainDataGrid}"
                          ColumnHeaderHeight="36"
                          RowHeight="34"
                          Margin="8,10,8,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Parameter}" Width="70" />
                                    <DataGridTextColumn Header="Error" Binding="{Binding Value}" Width="*" />
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1"
                Style="{StaticResource PanelBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                           Text="All Motor Move"
                           Style="{StaticResource PanelTitle}"
                           FontSize="18" />

                            <Grid Margin="8,10,8,8"
                      VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="76" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="38" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="95" />
                                    <ColumnDefinition Width="95" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- All Motor Move / Motor Select -->
                                <ItemsControl Grid.Row="0"
                                              Grid.Column="0"
                                              Grid.ColumnSpan="4"
                                              ItemsSource="{Binding CurrentScreen.Monitor.PicoAllMotorSelectButtons}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Height="36"
                                                    Margin="2,0"
                                                    Padding="2,0"
                                                    MinWidth="0"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding BackgroundBrush}"
                                                    BorderBrush="{Binding BorderBrush}"
                                                    Command="{Binding DataContext.CurrentScreen.Monitor.ExecuteOperationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{Binding}"
                                                    ContentTemplate="{StaticResource PicoButtonContentTemplate}"
                                                    Style="{StaticResource MonitorActionButton}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Cur Count" Style="{StaticResource MonitorSmallText}" VerticalAlignment="Center" />
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource MonitorInputCell}" Margin="0,3">
                                    <TextBlock Text="{Binding CurrentScreen.Monitor.OperationFields[7].Value}" Style="{StaticResource MonitorValueText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Set Count" Style="{StaticResource MonitorSmallText}" VerticalAlignment="Center" />
                                <Button Grid.Row="3" Grid.Column="1"
                                        Content="{Binding CurrentScreen.Monitor.OperationFields[8].Value}"
                                        Tag="{Binding CurrentScreen.Monitor.OperationFields[8]}"
                                        Click="OpenPicoValueInput"
                                        Margin="0,3"
                                        Style="{StaticResource PicoInputButton}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Position" Style="{StaticResource MonitorSmallText}" VerticalAlignment="Center" />
                                <Button Grid.Row="4" Grid.Column="1"
                                        Content="{Binding CurrentScreen.Monitor.OperationFields[9].Value}"
                                        Tag="{Binding CurrentScreen.Monitor.OperationFields[9]}"
                                        Click="OpenPicoValueInput"
                                        Margin="0,3"
                                        Style="{StaticResource PicoInputButton}" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="mm" Style="{StaticResource MonitorSmallText}" VerticalAlignment="Center" Margin="8,0,0,0" />

                                <!-- All Motor Move / Commands -->
                                <ItemsControl Grid.Row="6"
                                              Grid.Column="0"
                                              Grid.ColumnSpan="4"
                                              ItemsSource="{Binding CurrentScreen.Monitor.PicoAllMotorCommandButtons}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Height="38"
                                                    Margin="3,0"
                                                    Background="{Binding BackgroundBrush}"
                                                    BorderBrush="{Binding BorderBrush}"
                                                    Command="{Binding DataContext.CurrentScreen.Monitor.ExecuteOperationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{Binding}"
                                                    ContentTemplate="{StaticResource PicoWideButtonContentTemplate}"
                                                    Style="{StaticResource MonitorActionButton}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
</UserControl>

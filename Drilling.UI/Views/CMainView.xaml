                    <TextBlock DockPanel.Dock="Top" Text="Interlock / Safety" Style="{StaticResource PanelTitle}" />
                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1,0,0,0"
                            Padding="0,10,0,0"
                            Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Process Result" Style="{StaticResource MainValueText}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentScreen.MainOperating.ProcessResultValue}"
                                       Foreground="{Binding CurrentScreen.MainOperating.ProcessResultBrush}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right" />

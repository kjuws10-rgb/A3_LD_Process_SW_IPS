                                  Style="{StaticResource PlainDataGrid}"
                                  FontSize="12"
                                  ColumnHeaderHeight="38"
                                  RowHeight="34">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="148" />
                                <DataGridTextColumn Header="Product" Binding="{Binding ProductId}" Width="130" />
                                <DataGridTextColumn Header="Recipe" Binding="{Binding RecipeId}" Width="104" />

<UserControl x:Class="Drilling.UI.Views.CSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="SettingSmallText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="SettingValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SettingParameterValueButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HeaderNavPressedBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingTabButton" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingCommandButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter x:Name="ButtonContent"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                                <Setter TargetName="ButtonContent" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingGroupButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                <Setter TargetName="ItemBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource MenuItemSelectedBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource ButtonPrimaryBrush}" />
                                <Setter TargetName="ItemBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ButtonPrimaryBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Shell"
                                                Background="{DynamicResource GridBackgroundBrush}"
                                                BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                                            <Grid>
                                                <ContentPresenter Margin="10,0,34,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Path Data="M 0 0 L 5 5 L 10 0 Z"
                                                      Fill="{DynamicResource TextSecondaryBrush}"
                                                      Width="10"
                                                      Height="5"
                                                      Stretch="Fill"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Shell"
                                                        Property="Background"
                                                        Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                                <Setter TargetName="Shell"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource MenuItemSelectedBorderBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Shell"
                                                        Property="Background"
                                                        Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                                <Setter TargetName="Shell"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource ButtonPrimaryBorderBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource GridBackgroundBrush}"
                                        BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, ElementName=ToggleButton}">
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Visibility="{Binding CurrentScreen.IsSettingLayout, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="SETTING / PARAMETER CONFIG"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="31"
                       FontWeight="SemiBold" />
            <TextBlock Text="Direct grid edit for option, interface, IO and motor parameters"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="16" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="230" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ItemsControl Grid.Row="0"
                              ItemsSource="{Binding CurrentScreen.Setting.TabItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}"
                                    Command="{Binding DataContext.CurrentScreen.Setting.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Name}"
                                    Margin="0,0,4,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SettingTabButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Setting Group"
                                       Style="{StaticResource PanelTitle}"
                                       FontSize="18" />
                            <ItemsControl ItemsSource="{Binding CurrentScreen.Setting.GroupItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.CurrentScreen.Setting.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Name}"
                                                Style="{StaticResource SettingGroupButton}">
                                            <Border Height="58"
                                                    Margin="0,0,0,8"
                                                    Padding="0"
                                                    BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="5" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="28" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource ButtonDangerBorderBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}"
                                                               Grid.Column="1"
                                                               Margin="14,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="16"
                                                               FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Path Grid.Column="2"
                                                          Data="M4,4 L12,12 L4,20"
                                                          Stroke="{DynamicResource AccentTextBrush}"
                                                          StrokeThickness="2.4"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource PanelBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding CurrentScreen.Setting.SelectedTab, StringFormat={}{0} Parameter}"
                                           Style="{StaticResource PanelTitle}"
                                           FontSize="18" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource SettingCommandButton}"
                                            Background="{DynamicResource ButtonPrimaryBrush}"
                                            BorderBrush="{DynamicResource ButtonPrimaryBorderBrush}"
                                            Width="154"
                                            Margin="0,0,10,0"
                                            IsEnabled="{Binding CurrentScreen.Setting.CanOperateSelectedInterface}"
                                            Command="{Binding CurrentScreen.Setting.ConnectInterfaceCommand}"
                                            Visibility="{Binding CurrentScreen.Setting.IsInterfaceTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="18" Height="18" HorizontalAlignment="Center">
                                                <Path Data="M7,4 V9 M17,4 V9 M6,9 H18 V13 C18,16 16,18 13,18 H11 C8,18 6,16 6,13 V9 Z M12,18 V22"
                                                      Stroke="{DynamicResource TextPrimaryBrush}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Fill="Transparent" />
                                            </Viewbox>
                                            <TextBlock Grid.Column="1" Text="CONNECT" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource SettingCommandButton}"
                                            Background="{DynamicResource ButtonDangerBrush}"
                                            BorderBrush="{DynamicResource ButtonDangerBorderBrush}"
                                            Width="154"
                                            Margin="0,0,10,0"
                                            IsEnabled="{Binding CurrentScreen.Setting.CanOperateSelectedInterface}"
                                            Command="{Binding CurrentScreen.Setting.DisconnectInterfaceCommand}"
                                            Visibility="{Binding CurrentScreen.Setting.IsInterfaceTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="18" Height="18" HorizontalAlignment="Center">
                                                <Path Data="M7,4 V9 M17,4 V9 M6,9 H18 V13 C18,16 16,18 13,18 H11 C8,18 6,16 6,13 V9 Z M12,18 V22 M4,20 L20,4"
                                                      Stroke="{DynamicResource TextPrimaryBrush}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Fill="Transparent" />
                                            </Viewbox>
                                            <TextBlock Grid.Column="1" Text="DISCONNECT" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                     <Button Style="{StaticResource SettingCommandButton}"
                                             Background="{DynamicResource ButtonSuccessBrush}"
                                             BorderBrush="{DynamicResource StatusReadyBrush}"
                                             Width="112"
                                             Margin="0,0,10,0"
                                             PreviewMouseDown="CommitSettingGridEdits"
                                             Click="CommitSettingGridEdits"
                                             Command="{Binding CurrentScreen.Setting.SaveCommand}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="18" Height="18" HorizontalAlignment="Center">
                                                <Path Data="M5,4 H17 L20,7 V20 H4 V4 Z M8,4 V10 H16 V4 M8,17 H16"
                                                      Stroke="{DynamicResource TextPrimaryBrush}"
                                                      StrokeThickness="2"
                                                      StrokeLineJoin="Round"
                                                      Fill="Transparent" />
                                            </Viewbox>
                                            <TextBlock Grid.Column="1" Text="SAVE" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource SettingCommandButton}"
                                            Width="116"
                                            Margin="0,0,10,0"
                                            Command="{Binding CurrentScreen.Setting.CancelCommand}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="18" Height="18" HorizontalAlignment="Center">
                                                <Path Data="M5,5 L19,19 M19,5 L5,19"
                                                      Stroke="{DynamicResource TextMutedBrush}"
                                                      StrokeThickness="2.2"
                                                      StrokeStartLineCap="Round" />
                                            </Viewbox>
                                            <TextBlock Grid.Column="1" Text="CANCEL" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource SettingCommandButton}"
                                            Width="116"
                                            Command="{Binding CurrentScreen.Setting.ReloadCommand}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="18" Height="18" HorizontalAlignment="Center">
                                                <Path Data="M18,9 C17,6 15,4 12,4 C8,4 5,7 5,11 C5,15 8,18 12,18 C15,18 17,16 18,14 M18,5 V9 H14"
                                                      Stroke="{DynamicResource TextMutedBrush}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Fill="Transparent" />
                                            </Viewbox>
                                            <TextBlock Grid.Column="1" Text="RELOAD" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DataGrid x:Name="ParameterGrid"
                                          Grid.Row="0"
                                          ItemsSource="{Binding CurrentScreen.Setting.ParameterRows}"
                                          IsReadOnly="False"
                                          Style="{StaticResource PlainDataGrid}"
                                          FontSize="13"
                                          ColumnHeaderHeight="42"
                                          RowHeight="40"
                                          Visibility="{Binding CurrentScreen.Setting.IsParameterTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="120" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" Width="320" IsReadOnly="True" />
                                        <DataGridTemplateColumn Header="Value" Width="240">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Button Content="{Binding Value}"
                                                                FontWeight="SemiBold"
                                                                HorizontalContentAlignment="Left"
                                                                Padding="6,0"
                                                                PreviewMouseLeftButtonDown="OpenParameterValueInput">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource SettingParameterValueButton}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding UsesSelectionEditor}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <ComboBox ItemsSource="{Binding ValueOptions}"
                                                                  SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  VerticalContentAlignment="Center">
                                                            <ComboBox.Style>
                                                                <Style TargetType="ComboBox"
                                                                       BasedOn="{StaticResource SettingComboBox}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding UsesSelectionEditor}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ComboBox.Style>
                                                        </ComboBox>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Button Content="{Binding Value}"
                                                                FontWeight="SemiBold"
                                                                HorizontalContentAlignment="Left"
                                                                Padding="6,0"
                                                                PreviewMouseLeftButtonDown="OpenParameterValueInput">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource SettingParameterValueButton}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding UsesSelectionEditor}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <ComboBox ItemsSource="{Binding ValueOptions}"
                                                                  SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  VerticalContentAlignment="Center">
                                                            <ComboBox.Style>
                                                                <Style TargetType="ComboBox"
                                                                       BasedOn="{StaticResource SettingComboBox}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding UsesSelectionEditor}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ComboBox.Style>
                                                        </ComboBox>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="90" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Style="{StaticResource PanelBorder}"
                                        Visibility="{Binding CurrentScreen.Setting.IsInterfaceTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top"
                                                   Text="JHMI_INTERFACE.csv"
                                                   Style="{StaticResource PanelTitle}"
                                                   FontSize="18" />
                                        <DataGrid x:Name="InterfaceGrid"
                                                  ItemsSource="{Binding CurrentScreen.Setting.InterfaceRows}"
                                                  SelectedItem="{Binding CurrentScreen.Setting.SelectedInterfaceRow, Mode=TwoWay}"
                                                  IsReadOnly="False"
                                                  Style="{StaticResource PlainDataGrid}"
                                                  FontSize="12"
                                                  ColumnHeaderHeight="40"
                                                  RowHeight="38"
                                                  SelectionMode="Single"
                                                  SelectionUnit="FullRow"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" />
                                                            <Setter Property="BorderThickness" Value="4,0,0,0" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.CellStyle>
                                                <Style TargetType="DataGridCell" BasedOn="{StaticResource PlainDataGridCell}">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                                                    <Setter Property="BorderThickness" Value="0,0,1,0" />
                                                    <Setter Property="Padding" Value="10,4" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.CellStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="No."
                                                                    Binding="{Binding No, Mode=OneWay}"
                                                                    Width="48"
                                                                    IsReadOnly="True" />
                                                <DataGridTemplateColumn Header="TYPE" Width="126">
                                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingComboBox}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="DEVICE" Width="142"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Device}" Tag="DEVICE" Style="{StaticResource SettingParameterValueButton}" PreviewMouseLeftButtonDown="OpenInterfaceValueInput" HorizontalContentAlignment="Left" Padding="6,0" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="NUMBER" Width="78"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Number}" Tag="NUMBER" Style="{StaticResource SettingParameterValueButton}" PreviewMouseLeftButtonDown="OpenInterfaceValueInput" HorizontalContentAlignment="Left" Padding="6,0" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="NICKNAME" Width="142"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding NickName}" Tag="NICKNAME" Style="{StaticResource SettingParameterValueButton}" PreviewMouseLeftButtonDown="OpenInterfaceValueInput" HorizontalContentAlignment="Left" Padding="6,0" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="SYSTEM_SECTION" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding SystemSection}" Tag="SYSTEM_SECTION" Style="{StaticResource SettingParameterValueButton}" PreviewMouseLeftButtonDown="OpenInterfaceValueInput" HorizontalContentAlignment="Left" Padding="6,0" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="AUTOCONNECTION" Width="132"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding AutoConnectionOptions}" SelectedItem="{Binding AutoConnection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingComboBox}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="SIMUL" Width="82"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding AutoConnectionOptions}" SelectedItem="{Binding Simul, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingComboBox}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="ARG1" Width="122"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Arg1}" Tag="ARG1" Style="{StaticResource SettingParameterValueButton}" PreviewMouseLeftButtonDown="OpenInterfaceValueInput" HorizontalContentAlignment="Left" Padding="6,0" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="ARG2" Width="122"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Arg2}" Tag="ARG2" Style="{StaticResource SettingParameterValueButton}" PreviewMouseLeftButtonDown="OpenInterfaceValueInput" HorizontalContentAlignment="Left" Padding="6,0" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="ARG3" Width="92"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Arg3}" Tag="ARG3" Style="{StaticResource SettingParameterValueButton}" PreviewMouseLeftButtonDown="OpenInterfaceValueInput" HorizontalContentAlignment="Left" Padding="6,0" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="ARG4" Width="92"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Arg4}" Tag="ARG4" Style="{StaticResource SettingParameterValueButton}" PreviewMouseLeftButtonDown="OpenInterfaceValueInput" HorizontalContentAlignment="Left" Padding="6,0" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="ARG5" Width="82"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Arg5}" Tag="ARG5" Style="{StaticResource SettingParameterValueButton}" PreviewMouseLeftButtonDown="OpenInterfaceValueInput" HorizontalContentAlignment="Left" Padding="6,0" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Change History"
                                   Style="{StaticResource PanelTitle}"
                                   FontSize="18" />

                        <ItemsControl Grid.Column="1"
                                      ItemsSource="{Binding CurrentScreen.Setting.SummaryRows}"
                                      HorizontalAlignment="Right">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="260" Height="30" Margin="18,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}"
                                                   HorizontalAlignment="Right"
                                                   Style="{StaticResource SettingSmallText}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Value}"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{Binding ValueBrush}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding CurrentScreen.Setting.ChangeHistory}"
                              IsReadOnly="True"
                              Style="{StaticResource PlainDataGrid}"
                              FontSize="12"
                              ColumnHeaderHeight="42"
                              RowHeight="42">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="110" />
                            <DataGridTextColumn Header="User" Binding="{Binding User}" Width="100" />
                            <DataGridTextColumn Header="Tab" Binding="{Binding Tab}" Width="110" />
                            <DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" Width="260" />
                            <DataGridTextColumn Header="Before" Binding="{Binding Before}" Width="*" />
                            <DataGridTextColumn Header="After" Binding="{Binding After}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding AfterBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

                                      Style="{StaticResource PlainDataGrid}"
                                      FontSize="12"
                                      ColumnHeaderHeight="38"
                                      RowHeight="41"
                                      MinRowHeight="41"
                                      ScrollViewer.CanContentScroll="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.ScrollUnit="Item"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*" MinWidth="420" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="86" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Addr" Binding="{Binding Address}" Width="104" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding DataType}" Width="82" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Value" Binding="{Binding ReadValue}" Width="126" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{Binding ValueBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Poll" Binding="{Binding PollMs}" Width="70" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="8,0,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="WRITE Command"
                                       Style="{StaticResource PanelTitle}"
                                       FontSize="18" />
                            <DataGrid ItemsSource="{Binding CurrentScreen.Monitor.MelsecWriteRows}"
                                      Style="{StaticResource PlainDataGrid}"
                                      FontSize="12"
                                      ColumnHeaderHeight="38"
                                      RowHeight="41"
                                      MinRowHeight="41"
                                      ScrollViewer.CanContentScroll="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.ScrollUnit="Item"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*" MinWidth="420" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="86" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Addr" Binding="{Binding Address}" Width="104" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding DataType}" Width="82" IsReadOnly="True" />
                                    <DataGridTemplateColumn Header="Write Value" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Button Content="{Binding WriteValue}"
                                                            IsEnabled="{Binding CanWrite}"
                                                            Click="OpenMelsecWriteInput">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource MonitorInputButton}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding UsesWriteSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <ComboBox ItemsSource="{Binding WriteValueOptions}"
                                                              SelectedItem="{Binding WriteValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEnabled="{Binding CanWrite}">
                                                        <ComboBox.Style>
                                                            <Style TargetType="ComboBox" BasedOn="{StaticResource MonitorComboBox}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding UsesWriteSelection}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ComboBox.Style>
                                                    </ComboBox>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Write" Width="82">
                                        <DataGridTemplateColumn.CellStyle>
                                            <Style TargetType="DataGridCell" BasedOn="{StaticResource PlainDataGridCell}">
                                                <Setter Property="Padding" Value="4,2" />
                                            </Style>
                                        </DataGridTemplateColumn.CellStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="WRITE"
                                                        IsEnabled="{Binding CanWrite}"
                                                        Background="{DynamicResource ButtonWarningBrush}"
                                                        BorderBrush="{DynamicResource ButtonWarningBorderBrush}"
                                                        menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Monitor.WriteMelsecCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource IoCommandButton}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>

                    <Border Grid.Row="1" Style="{StaticResource PanelBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{Binding CurrentScreen.Monitor.HistoryPanelTitle}"
                                       Style="{StaticResource PanelTitle}"
                                       FontSize="18" />
                            <DataGrid ItemsSource="{Binding CurrentScreen.Monitor.CommandHistoryRows}"
                                      IsReadOnly="True"
                                      Style="{StaticResource PlainDataGrid}"
                                      FontSize="12"
                                      ColumnHeaderHeight="38"
                                      RowHeight="36"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="104" />
                                    <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="150" />
                                    <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="*" MinWidth="130" />
                                    <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{Binding ResultBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
            </Grid>

            <!-- Pico Motor: original full operation UI -->
            <views:CPicoMotorMonitorView
                DataContext="{Binding}"
                Visibility="{Binding CurrentScreen.Monitor.IsPicoMotor, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Grid Visibility="{Binding CurrentScreen.Monitor.IsCoordinateViewer, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="112" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource PanelBorder}"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="VIEW BASIS"
                                   Style="{StaticResource PanelTitle}"
                                   FontSize="18"
                                   VerticalAlignment="Center" />

                        <ItemsControl Grid.Column="1"
                                      ItemsSource="{Binding CurrentScreen.Monitor.CoordinateBasisOptions}"
                                      Margin="0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Height="58"
                                            Margin="5,0"
                                            Background="{Binding BackgroundBrush}"
                                            BorderBrush="{Binding BorderBrush}"
                                            Foreground="{Binding TextBrush}"
                                            BorderThickness="1"
                                            menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Monitor.SelectCoordinateBasisCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Name}"
                                                   HorizontalAlignment="Center"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="580" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource PanelBorder}"
                            Margin="0,0,12,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="SETTING / RECIPE POSITION VALUES"
                                       Style="{StaticResource PanelTitle}"
                                       FontSize="18" />
                            <DataGrid ItemsSource="{Binding CurrentScreen.Monitor.CoordinateValueRows}"
                                      IsReadOnly="True"
                                      Style="{StaticResource PlainDataGrid}"
                                      FontSize="13"
                                      ColumnHeaderHeight="36"
                                      RowHeight="34"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Source}" Width="78" />
                                    <DataGridTextColumn Header="Item" Binding="{Binding Parameter}" Width="*" MinWidth="280" />
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="100" />
                                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="54" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource PanelBorder}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="COORDINATE PREVIEW"
                                           Style="{StaticResource PanelTitle}"
                                           FontSize="18" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentScreen.Monitor.CoordinateSelectedBasisName}"
                                               Foreground="{DynamicResource AccentTextBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,18,0" />
                                    <TextBlock Text="{Binding CurrentScreen.Monitor.CoordinateSelectedCellName}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="14"
                                               Margin="0,0,18,0" />
                                    <TextBlock Text="{Binding CurrentScreen.Monitor.CoordinateSelectedHoleName}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="14" />
                                </StackPanel>
                            </Grid>

                            <Border Visibility="{Binding CurrentScreen.Monitor.CoordinateIsGlassPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="{DynamicResource GridBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"

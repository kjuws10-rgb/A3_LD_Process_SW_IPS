                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal"
                                                                        Margin="0,0,12,0"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Item}"
                                                                           Style="{StaticResource MainOpticRowLabelText}"
                                                                           Margin="0,0,6,0" />
                                                                <TextBlock Text="{Binding Current}"
                                                                           Style="{StaticResource MainOpticValueText}"
                                                                           Margin="0,0,6,0" />
                                                                <TextBlock Text="{Binding RecipeTarget}"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border Grid.Column="2"
                                                        Style="{StaticResource MainOpticBadge}"

                            <DataGridTextColumn Header="Signal" Binding="{Binding Signal}" Width="128" ElementStyle="{StaticResource MainGridText}" />
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="86" ElementStyle="{StaticResource MainGridText}" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" MinWidth="220" ElementStyle="{StaticResource MainGridText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>



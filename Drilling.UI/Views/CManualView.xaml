                                    <DataTemplate>
                                        <Grid>
                                            <Button Content="{Binding Value}" IsEnabled="{Binding IsEditable}" Click="OpenCommandStateInput" Height="28" Padding="8,2" FontSize="13">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ManualInputButton}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding UsesSelectionEditor}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                            </Button>
                                            <ComboBox ItemsSource="{Binding ValueOptions}" SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="28">
                                                <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource ManualComboBox}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding UsesSelectionEditor}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ComboBox.Style>
                                            </ComboBox>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Unit"
                                                Binding="{Binding Unit}"
                                                IsReadOnly="True"
                                                Width="62" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2"
              Grid.RowSpan="2"
              Margin="0,6,0,0"
              Visibility="{Binding CurrentScreen.Manual.IsStageVisionWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.82*" />
                <ColumnDefinition Width="1.18*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,6,0"
                    Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Stage Control"
                               Style="{StaticResource PanelTitle}" />

                    <ItemsControl Grid.Row="1"
                                  Margin="0,18,0,0"
                                  ItemsSource="{Binding CurrentScreen.Manual.StageAxes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="44" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayAxis}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="22"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="AXIS"
                                                       Style="{StaticResource ManualSmallText}"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>

                                        <Grid Grid.Column="1" Margin="0,0,6,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="40" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Current Position"
                                                       Style="{StaticResource ManualSmallText}"
                                                       Margin="0,0,0,6" />
                                            <Border Grid.Row="1"
                                                    Background="{DynamicResource GridBackgroundBrush}"
                                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                                    BorderThickness="1"
                                                    Padding="12,0">
                                                <Grid>
                                                    <TextBlock Text="{Binding CurrentPosition}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Unit}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource ManualSmallText}" />
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Column="2" Margin="6,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="40" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Target Position"
                                                       Style="{StaticResource ManualSmallText}"
                                                       Margin="0,0,0,6" />
                                            <Grid Grid.Row="1">
                                                <Button Content="{Binding TargetPosition}"
                                                        Click="OpenStageTargetInput"
                                                        Style="{StaticResource ManualInputButton}"
                                                        Height="40"
                                                        Padding="12,7,44,7" />
                                                <TextBlock Text="{Binding Unit}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"
                                                           Style="{StaticResource ManualSmallText}"
                                                           IsHitTestVisible="False" />
                                            </Grid>
                                        </Grid>
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Content="HOME"
                                                menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Manual.StageHomeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource ManualCommandButton}"
                                                Margin="0,0,6,0" />
                                        <Button Grid.Column="1"
                                                Content="MOVE"
                                                menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Manual.StageMoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ManualCommandButton}"
                                                Margin="6,0" />
                                        <Button Grid.Column="2"
                                                Content="STOP"
                                                menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Manual.StageStopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource ManualCommandButton}"
                                                Background="{DynamicResource ButtonDangerBrush}"
                                                BorderBrush="{DynamicResource ButtonDangerBorderBrush}"
                                                Margin="6,0,0,0" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Margin="6,0,0,0"
                    Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="64" />
                        <RowDefinition Height="64" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Vision Capture"
                               Style="{StaticResource PanelTitle}" />

                    <Border Grid.Row="1"
                            Margin="0,10,0,0"
                            Background="{DynamicResource GridBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1"
                            Padding="8">
                        <Grid>
                            <Image Source="{Binding CurrentScreen.Manual.VisionImage}"
                                   Stretch="Uniform" />
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentScreen.Manual.HasVisionImage}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="VISION IMAGE"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Press SHOT to capture the current camera image"
                                           Style="{StaticResource ManualSmallText}"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Status" Style="{StaticResource ManualSmallText}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CurrentScreen.Manual.VisionCaptureStatus}"
                                   Style="{StaticResource ManualValueText}"
                                   FontSize="12" />
                        <TextBlock Grid.Row="1" Text="Captured At" Style="{StaticResource ManualSmallText}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding CurrentScreen.Manual.VisionCaptureTime}"
                                   Style="{StaticResource ManualValueText}"
                                   FontSize="12" />
                    </Grid>

                    <Button Grid.Row="3"
                            Content="SHOT"
                            menu:CButtonCommandBehavior.Command="{Binding CurrentScreen.Manual.VisionShotCommand}"
                            Style="{StaticResource ManualCommandButton}"
                            Background="{DynamicResource ButtonSuccessBrush}"
                            BorderBrush="{DynamicResource StatusReadyBrush}"
                            Margin="0,10,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>



                                                <DataTemplate>
                                                    <ItemsControl ItemsSource="{Binding Holes}"
                                                                  HorizontalAlignment="Stretch"
                                                                  Margin="0,0,0,5">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>

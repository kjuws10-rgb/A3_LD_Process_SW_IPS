<UserControl x:Class="Drilling.UI.Views.CMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="MainSmallText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="MainValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MainSequenceButton" TargetType="Button">
            <Setter Property="Width" Value="132" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MainStartButton" TargetType="Button" BasedOn="{StaticResource MainSequenceButton}">
            <Setter Property="Background" Value="{DynamicResource ButtonSuccessBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StatusReadyBrush}" />
        </Style>
        <Style x:Key="MainStopButton" TargetType="Button" BasedOn="{StaticResource MainSequenceButton}">
            <Setter Property="Background" Value="{DynamicResource ButtonDangerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonDangerBorderBrush}" />
        </Style>
        <Style x:Key="MainStepOptionButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="21" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MainParameterTabButton" TargetType="Button" BasedOn="{StaticResource MainSequenceButton}">
            <Setter Property="Width" Value="140" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="HeadSelectButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="HeadSelectItemTemplate">
            <Button Command="{Binding DataContext.CurrentScreen.MainOperating.TogglePreviewHeadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding HeadNo}"
                    Style="{StaticResource HeadSelectButton}">
                <Border Margin="2"
                        Padding="7"
                        BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding HeadName}"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="{Binding StatusBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Status}"
                                       Margin="4,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>
        <Style x:Key="MainDataGrid" TargetType="DataGrid" BasedOn="{StaticResource PlainDataGrid}">
            <Setter Property="MinRowHeight" Value="32" />
            <Setter Property="ColumnHeaderHeight" Value="34" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        </Style>
        <Style x:Key="MainGridText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="MainOpticCard" TargetType="Border">
            <Setter Property="Height" Value="146" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style x:Key="MainOpticItemCard" TargetType="Border">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style x:Key="MainOpticLabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MainOpticValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="MainOpticSummaryCard" TargetType="Border">
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style x:Key="MainOpticHeadCard" TargetType="Border">
            <Setter Property="MinHeight" Value="150" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style x:Key="MainOpticRowLabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="MainOpticCompactValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="MainOpticSubValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="MainOpticBadge" TargetType="Border">
            <Setter Property="Height" Value="18" />
            <Setter Property="MinWidth" Value="45" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="MainOpticSectionCard" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style x:Key="MainOpticHeadMiniCard" TargetType="Border">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="MainOpticStatusChip" TargetType="Border">
            <Setter Property="Height" Value="18" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="314" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                <TextBlock Text="MAIN / AUTO PROCESS"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock Text="Scan path preview, script lifecycle status"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="14" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <Button Command="{Binding StartCommand}"
                            Style="{StaticResource MainStartButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text=">"
                                       FontSize="15"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="START" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding StopCommand}"
                            Style="{StaticResource MainStopButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="[]"
                                       FontSize="13"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="STOP" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="315" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="560" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="76" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Process Sequence" Style="{StaticResource PanelTitle}" />

                        <Grid Grid.Row="1" Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="No"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       Text="Step"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2"
                                       Text="State"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4"
                                       Text="Use"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold" />
                        </Grid>

                        <ScrollViewer Grid.Row="2"
                                      Margin="0,0,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding CurrentScreen.MainOperating.ProcessSequenceItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,5"
                                                Padding="8,4"
                                                Background="{DynamicResource PanelBackgroundBrush}"
                                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                                BorderThickness="1"
                                                MinHeight="32">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="48" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="19"
                                                        Height="19"
                                                        BorderBrush="{DynamicResource TextMutedBrush}"
                                                        BorderThickness="1"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Order}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding StepName}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding State}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding StateBrush}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="3"
                                                        Width="1"
                                                        Height="18"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource PanelBorderBrush}"
                                                        Opacity="0.75" />
                                                <Button Grid.Column="4"
                                                        Content="{Binding OptionText}"
                                                        Command="{Binding DataContext.CurrentScreen.MainOperating.ToggleSequenceStepUseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding OptionSettingKey}"
                                                        Visibility="{Binding OptionVisibility}"
                                                        IsEnabled="{Binding CanToggleOption}"
                                                        Opacity="{Binding OptionOpacity}"
                                                        Background="{Binding OptionBrush}"
                                                        BorderBrush="{Binding OptionBorderBrush}"
                                                        Style="{StaticResource MainStepOptionButton}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                    <ItemsControl ItemsSource="{Binding CurrentScreen.MainOperating.ProcessSummaryItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="4,0">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Value}"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>

            <Border Grid.Column="1" Margin="12,0" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="54" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="54" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="Head Assignment / Glass Preview"
                                   Style="{StaticResource PanelTitle}" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Content="ALL"
                                    Command="{Binding CurrentScreen.MainOperating.TogglePreviewHeadCommand}"
                                    CommandParameter="ALL"
                                    Style="{StaticResource MainSequenceButton}"
                                    Width="48"
                                    Height="24"
                                    Margin="4,0,0,0"
                                    Padding="0"
                                    FontSize="10"
                                    Background="{DynamicResource ButtonSecondaryBrush}"
                                    BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}" />
                            <Button Content="CLEAR"
                                    Command="{Binding CurrentScreen.MainOperating.TogglePreviewHeadCommand}"
                                    CommandParameter="CLEAR"
                                    Style="{StaticResource MainSequenceButton}"
                                    Width="54"
                                    Height="24"
                                    Margin="4,0,0,0"
                                    Padding="0"
                                    FontSize="10"
                                    Background="{DynamicResource ButtonSecondaryBrush}"
                                    BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl Grid.Column="0"
                                      Grid.ColumnSpan="8"
                                      ItemsSource="{Binding CurrentScreen.MainOperating.OddHeadPreviews}"
                                      ItemTemplate="{StaticResource HeadSelectItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,10">
                        <Viewbox Stretch="Uniform">
                            <Canvas Width="860" Height="520" Background="{DynamicResource GridBackgroundBrush}">
                                 <Rectangle Canvas.Left="{Binding CurrentScreen.MainOperating.GlassFrame.CanvasLeft}"
                                            Canvas.Top="{Binding CurrentScreen.MainOperating.GlassFrame.CanvasTop}"
                                            Width="{Binding CurrentScreen.MainOperating.GlassFrame.Width}"
                                            Height="{Binding CurrentScreen.MainOperating.GlassFrame.Height}"
                                            Stroke="{DynamicResource PanelBorderBrush}"
                                            StrokeThickness="1.4"
                                            Fill="{DynamicResource PanelAltBackgroundBrush}" />

                                <Image Canvas.Left="0"
                                       Canvas.Top="0"
                                       Width="860"
                                       Height="520"
                                       Source="{Binding CurrentScreen.MainOperating.RecipePreviewImage}"
                                       Stretch="None"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top" />

                                <ItemsControl Canvas.Left="0"
                                              Canvas.Top="0"
                                              Width="860"
                                              Height="520"
                                              ItemsSource="{Binding CurrentScreen.MainOperating.HeadAssignmentAreas}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="860" Height="520" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
                                            <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Rectangle Width="{Binding Width}"
                                                       Height="{Binding Height}"
                                                       Fill="{Binding FillBrush}"
                                                       Stroke="{Binding StrokeBrush}"
                                                       StrokeThickness="{Binding BorderThicknessValue.Left}"
                                                       StrokeDashArray="5,3"
                                                       StrokeDashCap="Flat"
                                                       Opacity="{Binding Opacity}"
                                                       Visibility="{Binding RangeVisibility}"
                                                       SnapsToDevicePixels="True" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl Canvas.Left="0"
                                              Canvas.Top="0"
                                              Width="860"
                                              Height="520"
                                              ItemsSource="{Binding CurrentScreen.MainOperating.HeadAssignmentAreas}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="860" Height="520" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding LabelCanvasLeft}" />
                                            <Setter Property="Canvas.Top" Value="{Binding LabelCanvasTop}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                             <Border Width="{Binding LabelWidth}"
                                                     Height="20"
                                                     Background="{DynamicResource PanelBackgroundBrush}"
                                                     BorderBrush="{Binding StrokeBrush}"
                                                     BorderThickness="0,0,0,1"
                                                     Visibility="{Binding RangeVisibility}">
                                                <TextBlock Text="{Binding DisplayLabel}"
                                                           Foreground="{Binding StrokeBrush}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                 <!-- The physical Glass uses the same restrained accent as the rest of the HMI. -->
                                 <Rectangle Canvas.Left="{Binding CurrentScreen.MainOperating.GlassFrame.CanvasLeft}"
                                            Canvas.Top="{Binding CurrentScreen.MainOperating.GlassFrame.CanvasTop}"
                                            Width="{Binding CurrentScreen.MainOperating.GlassFrame.Width}"
                                            Height="{Binding CurrentScreen.MainOperating.GlassFrame.Height}"
                                            Fill="Transparent"
                                            Stroke="{DynamicResource MenuItemSelectedBorderBrush}"
                                            StrokeThickness="1.8"
                                            Opacity="0.9"
                                            IsHitTestVisible="False"
                                            SnapsToDevicePixels="True" />

                                 <TextBlock Canvas.Left="54"
                                           Canvas.Top="14"
                                           Text="GLASS AREA"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <TextBlock Canvas.Right="54"
                                           Canvas.Top="4"
                                           Width="320"
                                           Text="{Binding CurrentScreen.MainOperating.GlassPreviewSummary}"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextAlignment="Right"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                            </Canvas>
                        </Viewbox>
                        <ItemsControl ItemsSource="{Binding CurrentScreen.MainOperating.CellPreviewLabels}"
                                      Style="{StaticResource CellPreviewLabelItemsControl}" />
                    </Grid>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl Grid.Column="1"
                                      Grid.ColumnSpan="8"
                                      ItemsSource="{Binding CurrentScreen.MainOperating.EvenHeadPreviews}"
                                      ItemTemplate="{StaticResource HeadSelectItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>

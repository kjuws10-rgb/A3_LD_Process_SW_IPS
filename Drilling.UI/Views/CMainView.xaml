                            <DataGridTextColumn Header="Err X" Binding="{Binding ErrorX}" Width="68" ElementStyle="{StaticResource MainGridText}" />
                            <DataGridTextColumn Header="Err Y" Binding="{Binding ErrorY}" Width="68" ElementStyle="{StaticResource MainGridText}" />
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="62">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MainGridText}">
                                        <Setter Property="Foreground" Value="{Binding StateBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Judge" Binding="{Binding Judge}" Width="52">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MainGridText}">
                                        <Setter Property="Foreground" Value="{Binding JudgeBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>


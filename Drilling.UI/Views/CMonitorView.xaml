<UserControl x:Class="Drilling.UI.Views.CMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:menu="clr-namespace:Drilling.UI.Menu"
             xmlns:ui="clr-namespace:Drilling.UI"
             xmlns:views="clr-namespace:Drilling.UI.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="MonitorSmallText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="MonitorValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CoordinatePreviewFillItemContainer" TargetType="ContentPresenter">
            <Setter Property="ui:CPreviewCoordinateBehavior.PositionX" Value="{Binding CanvasCenterX}" />
            <Setter Property="ui:CPreviewCoordinateBehavior.PositionY" Value="{Binding CanvasCenterY}" />
            <Setter Property="ui:CPreviewCoordinateBehavior.ContainerWidth" Value="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=ActualWidth}" />
            <Setter Property="ui:CPreviewCoordinateBehavior.ContainerHeight" Value="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=ActualHeight}" />
            <Setter Property="ui:CPreviewCoordinateBehavior.DesignWidth" Value="{Binding DesignWidth}" />
            <Setter Property="ui:CPreviewCoordinateBehavior.DesignHeight" Value="{Binding DesignHeight}" />
            <Setter Property="ui:CPreviewCoordinateBehavior.ElementWidth" Value="{Binding Width}" />
            <Setter Property="ui:CPreviewCoordinateBehavior.ElementHeight" Value="{Binding Height}" />
            <Setter Property="ui:CPreviewCoordinateBehavior.UseStretchScale" Value="True" />
        </Style>

        <Style x:Key="MonitorInputButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="InputBorder" Property="Background" Value="{DynamicResource HeaderNavPressedBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonitorComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" /><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" /><Setter Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonPrimaryBrush}" /><Setter Property="Foreground" Value="{DynamicResource ButtonTextOnColorBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonitorComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource MonitorComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Shell" Background="{DynamicResource GridBackgroundBrush}" BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}" BorderThickness="1"><Grid><TextBlock x:Name="SelectedText" Margin="8,0,28,0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" /><Path Data="M 0 0 L 5 5 L 10 0 Z" Fill="{DynamicResource TextSecondaryBrush}" Width="10" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" /></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" /><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource MenuItemSelectedBorderBrush}" /><Setter TargetName="SelectedText" Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" /></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Shell" Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" /><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}" /><Setter TargetName="SelectedText" Property="Foreground" Value="{DynamicResource MenuItemSelectedTextBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"><Border Background="{DynamicResource GridBackgroundBrush}" BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}" BorderThickness="1" MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"><ScrollViewer MaxHeight="220"><ItemsPresenter /></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonitorTabButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonitorActionButton" TargetType="Button">
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IoCommandButton" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Width" Value="66" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonitorInputCell" TargetType="Border">
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="MonitorInputTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Visibility="{Binding CurrentScreen.IsMonitorLayout, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding CurrentScreen.Monitor.Title}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="31"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding CurrentScreen.Monitor.Subtitle}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="15" />
        </StackPanel>

        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding CurrentScreen.Monitor.Tabs}"
                      Margin="0,6,0,6">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Name}"
                            menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Monitor.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Name}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MonitorTabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="2">
            <Grid Visibility="{Binding CurrentScreen.Monitor.IsIo, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44*" />
                    <ColumnDefinition Width="56*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,12,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Input Monitor"
                                   Style="{StaticResource PanelTitle}"
                                   FontSize="18" />
                        <DataGrid ItemsSource="{Binding CurrentScreen.Monitor.InputRows}"
                                  IsReadOnly="True"
                                  Style="{StaticResource PlainDataGrid}"
                                  FontSize="12"
                                  ColumnHeaderHeight="42"
                                  RowHeight="38">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="100" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTemplateColumn Header="State" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StateBrush}"
                                                    CornerRadius="4"
                                                    Width="56"
                                                    Height="24"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding State}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Output Monitor"
                                       Style="{StaticResource PanelTitle}"
                                       FontSize="18" />
                            <TextBlock Grid.Column="1"
                                       Text="Output rows can be operated directly from ON / OFF cells"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,10" />
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding CurrentScreen.Monitor.OutputRows}"
                                  IsReadOnly="True"
                                  Style="{StaticResource PlainDataGrid}"
                                  FontSize="12"
                                  ColumnHeaderHeight="42"
                                  RowHeight="38">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="96" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTemplateColumn Header="State" Width="96">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StateBrush}"
                                                    CornerRadius="4"
                                                    Width="56"
                                                    Height="24"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding State}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="ON" Width="96">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="ON"
                                                    Background="{DynamicResource ButtonSuccessBrush}"
                                                    BorderBrush="{DynamicResource StatusReadyBrush}"
                                                    menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Monitor.SetOutputOnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}"
                                                    Style="{StaticResource IoCommandButton}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="OFF" Width="96">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="OFF"
                                                    Background="{DynamicResource ButtonSecondaryBrush}"
                                                    BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}"
                                                    menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Monitor.SetOutputOffCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}"
                                                    Style="{StaticResource IoCommandButton}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Visibility="{Binding CurrentScreen.Monitor.IsMotor, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="610" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="250" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,12,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Axis Monitor"
                                   Style="{StaticResource PanelTitle}"
                                   FontSize="18" />
                        <DataGrid ItemsSource="{Binding CurrentScreen.Monitor.AxisRows}"
                                  SelectedItem="{Binding CurrentScreen.Monitor.SelectedAxisRow, Mode=TwoWay}"
                                  IsReadOnly="True"
                                  Style="{StaticResource PlainDataGrid}"
                                  FontSize="12"
                                  ColumnHeaderHeight="36"
                                  RowHeight="34"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Axis" Binding="{Binding Axis}" Width="112" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="130" />
                                <DataGridTextColumn Header="Current" Binding="{Binding CurrentPosition}" Width="105" />
                                <DataGridTextColumn Header="Target" Binding="{Binding TargetPosition}" Width="105" />
                                <DataGridTextColumn Header="Command" Binding="{Binding CommandPosition}" Width="110" />
                                <DataGridTextColumn Header="Servo" Binding="{Binding Servo}" Width="50">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding ServoBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Home" Binding="{Binding Home}" Width="56" />
                                <DataGridTextColumn Header="Lim +" Binding="{Binding LimitPlus}" Width="56" />
                                <DataGridTextColumn Header="Lim -" Binding="{Binding LimitMinus}" Width="56" />
                                <DataGridTextColumn Header="Alarm" Binding="{Binding Alarm}" Width="50" />
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="68">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding StateBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,12,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding CurrentScreen.Monitor.HistoryPanelTitle}"
                                   Style="{StaticResource PanelTitle}"
                                   FontSize="18" />
                        <DataGrid ItemsSource="{Binding CurrentScreen.Monitor.CommandHistoryRows}"
                                  IsReadOnly="True"
                                  Style="{StaticResource PlainDataGrid}"
                                  FontSize="12"
                                  ColumnHeaderHeight="38"
                                  RowHeight="34">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="210" />
                                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="140" />
                                <DataGridTextColumn Header="Axis" Binding="{Binding Name}" Width="160" />
                                <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="210" />
                                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="200" />
                                <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding ResultBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="142" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding CurrentScreen.Monitor.SelectedAxisId, StringFormat=Axis Operation  (Selected Axis : {0})}"
                                   Style="{StaticResource PanelTitle}"
                                   FontSize="18" />
                        <ItemsControl Grid.Row="1"
                                      ItemsSource="{Binding CurrentScreen.Monitor.OperationButtons}"
                                      Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Background="{Binding BackgroundBrush}"
                                            BorderBrush="{Binding BorderBrush}"
                                            menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Monitor.ExecuteOperationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Height="Auto"
                                            VerticalAlignment="Stretch"
                                            Style="{StaticResource MonitorActionButton}">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="18" Height="18">
                                                <Path Data="{Binding IconGeometry}"
                                                      Stroke="{DynamicResource TextPrimaryBrush}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Fill="Transparent" />
                                            </Viewbox>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Label}"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl Grid.Row="2"
                                      ItemsSource="{Binding CurrentScreen.Monitor.OperationFields}"
                                      Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="38">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Parameter}"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource MonitorSmallText}" />
                                        <Border Grid.Column="1" Style="{StaticResource MonitorInputCell}">
                                            <TextBlock Text="{Binding Value}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentTextBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Unit}"
                                                   Margin="10,0,0,8"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource MonitorSmallText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding CurrentScreen.Monitor.ParameterPanelTitle}"
                                   Style="{StaticResource PanelTitle}"
                                   FontSize="18" />
                        <DataGrid ItemsSource="{Binding CurrentScreen.Monitor.ParameterRows}"
                                  IsReadOnly="True"
                                  Style="{StaticResource PlainDataGrid}"
                                  FontSize="12"
                                  ColumnHeaderHeight="38"
                                  RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" Width="220" />
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="180">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding ValueBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <Grid Visibility="{Binding CurrentScreen.Monitor.IsPowerMeter, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Style="{StaticResource PanelBorder}" Margin="0,0,8,4" Padding="8,1">
                    <TextBlock Text="PROCESS LIST"
                               Style="{StaticResource PanelTitle}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <Border Grid.Row="1" Grid.RowSpan="15" Grid.Column="0" Grid.ColumnSpan="4" Style="{StaticResource PanelBorder}" Margin="0,0,8,8">
                    <DockPanel>
                        <DataGrid ItemsSource="{Binding CurrentScreen.Monitor.PwmProcessRows}"
                                  SelectedItem="{Binding CurrentScreen.Monitor.SelectedPwmProcessRow, Mode=TwoWay}"
                                  IsReadOnly="True"
                                  Style="{StaticResource PlainDataGrid}"
                                  FontSize="12"
                                  ColumnHeaderHeight="38"
                                  RowHeight="38"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Foreground" Value="{Binding RowBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NO" Binding="{Binding No}" Width="58" />
                                <DataGridTextColumn Header="FILE NAME" Binding="{Binding ProcessName}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding RowBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <ItemsControl Grid.Row="16" Grid.RowSpan="4" Grid.Column="0" Grid.ColumnSpan="4"
                              ItemsSource="{Binding CurrentScreen.Monitor.PwmProcessButtons}"
                              Margin="0,0,8,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="2" Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Background="{Binding BackgroundBrush}"
                                    BorderBrush="{Binding BorderBrush}"
                                    menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Monitor.ExecuteOperationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Height="Auto"
                                    Margin="4"
                                    VerticalAlignment="Stretch"
                                    Style="{StaticResource MonitorActionButton}">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="16" Height="16">
                                        <Path Data="{Binding IconGeometry}"
                                              Stroke="{DynamicResource TextPrimaryBrush}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Fill="Transparent" />
                                    </Viewbox>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Label}"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="16" Style="{StaticResource PanelBorder}" Margin="0,0,0,4" Padding="8,1">
                    <TextBlock Text="MEASURE STEP"
                               Style="{StaticResource PanelTitle}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <Border Grid.Row="1" Grid.RowSpan="9" Grid.Column="4" Grid.ColumnSpan="16" Style="{StaticResource PanelBorder}" Margin="0,0,0,8">
                    <DataGrid ItemsSource="{Binding CurrentScreen.Monitor.PwmStepRows}"
                              SelectedItem="{Binding CurrentScreen.Monitor.SelectedPwmStepRow, Mode=TwoWay}"
                              IsReadOnly="True"
                              Style="{StaticResource PlainDataGrid}"
                              FontSize="11"
                              ColumnHeaderHeight="36"
                              RowHeight="33"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="{Binding RowBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="Opacity" Value="1" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBackgroundBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding State}" Value="RUN">
                                        <Setter Property="Background" Value="{DynamicResource ButtonWarningBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ButtonWarningBorderBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Name="PwmStepRunBlink">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1"
                                                                     To="0.45"
                                                                     Duration="0:0:0.45"
                                                                     AutoReverse="True"
                                                                     RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="PwmStepRunBlink" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NO" Binding="{Binding Step}" Width="50" />
                            <DataGridTextColumn Header="Option Name" Binding="{Binding OptionName}" Width="*" MinWidth="145" />
                            <DataGridTextColumn Header="Power (%)" Binding="{Binding SettingPower}" Width="88" />
                            <DataGridTextColumn Header="Freq (kHz)" Binding="{Binding SettingFreq}" Width="86" />
                            <DataGridTextColumn Header="Cycle" Binding="{Binding MeasureCycle}" Width="64" />
                            <DataGridTextColumn Header="Measure Time" Binding="{Binding MeasureTime}" Width="106" />
                            <DataGridTextColumn Header="Interval Time" Binding="{Binding MeasureInterval}" Width="108" />
                            <DataGridTextColumn Header="Start Delay" Binding="{Binding StartDelay}" Width="96" />
                            <DataGridTextColumn Header="Cooling Time" Binding="{Binding CycleDelay}" Width="98" />
                            <DataGridTextColumn Header="ATT Power(%)" Binding="{Binding SettingAtt}" Width="100" />
                            <DataGridTextColumn Header="Rotator" Binding="{Binding Rotator}" Width="78" />
                            <DataGridTextColumn Header="MeasurePower(W)" Binding="{Binding MeasurePower}" Width="122" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="10" Grid.Column="4" Grid.ColumnSpan="11" Style="{StaticResource PanelBorder}" Margin="0,0,8,4" Padding="8,1">
                    <TextBlock Text="SETTING"
                               Style="{StaticResource PanelTitle}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <Border Grid.Row="11" Grid.RowSpan="9" Grid.Column="4" Grid.ColumnSpan="8" Style="{StaticResource PanelBorder}" Margin="0,0,8,0">
                    <DataGrid ItemsSource="{Binding CurrentScreen.Monitor.PwmSettingRows}"
                              IsReadOnly="False"
                              Style="{StaticResource PlainDataGrid}"
                              FontSize="12"
                              ColumnHeaderHeight="34"
                              RowHeight="28">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Index" Binding="{Binding Parameter}" Width="210" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Param" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Button Content="{Binding Value}"
                                                    Click="OpenPowerMeterSettingInput">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource MonitorInputButton}">
                                                        <Setter Property="Foreground" Value="{Binding ValueBrush}" />
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UsesSelectionEditor}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <ComboBox ItemsSource="{Binding ValueOptions}"
                                                      SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Padding="6,0"
                                                      VerticalContentAlignment="Center">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox" BasedOn="{StaticResource MonitorComboBox}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UsesSelectionEditor}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <ItemsControl Grid.Row="11" Grid.RowSpan="9" Grid.Column="12" Grid.ColumnSpan="3"
                              ItemsSource="{Binding CurrentScreen.Monitor.PwmStepButtons}"
                              Margin="0,0,8,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Background="{Binding BackgroundBrush}"
                                    BorderBrush="{Binding BorderBrush}"
                                    menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Monitor.ExecuteOperationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Height="Auto"
                                    Margin="4"
                                    Padding="8,0"
                                    VerticalAlignment="Stretch"
                                    Style="{StaticResource MonitorActionButton}">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="16" Height="16">
                                        <Path Data="{Binding IconGeometry}"
                                              Stroke="{DynamicResource TextPrimaryBrush}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Fill="Transparent" />
                                    </Viewbox>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Label}"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="10" Grid.Column="15" Grid.ColumnSpan="5" Style="{StaticResource PanelBorder}" Margin="0,0,0,4" Padding="8,1">
                    <TextBlock Text="OPERATION"
                               Style="{StaticResource PanelTitle}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <ItemsControl Grid.Row="11" Grid.RowSpan="3" Grid.Column="15" Grid.ColumnSpan="5"
                              ItemsSource="{Binding CurrentScreen.Monitor.PwmRunButtons}"
                              Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Background="{Binding BackgroundBrush}"
                                    BorderBrush="{Binding BorderBrush}"
                                    menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Monitor.ExecuteOperationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Height="Auto"
                                    Margin="4"
                                    Padding="8,0"
                                    VerticalAlignment="Stretch"
                                    Style="{StaticResource MonitorActionButton}">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="18" Height="18">
                                        <Path Data="{Binding IconGeometry}"
                                              Stroke="{DynamicResource TextPrimaryBrush}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Fill="Transparent" />
                                    </Viewbox>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Label}"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="14" Grid.RowSpan="6" Grid.Column="15" Grid.ColumnSpan="5" Style="{StaticResource PanelBorder}">
                    <DataGrid ItemsSource="{Binding CurrentScreen.Monitor.PwmDeviceRows}"
                              IsReadOnly="True"
                              Style="{StaticResource PlainDataGrid}"
                              FontSize="12"
                              ColumnHeaderHeight="0"
                              HeadersVisibility="None"
                              RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Item}" Width="134" />
                            <DataGridTextColumn Binding="{Binding Value}" Width="*" MinWidth="96">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding ValueBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Width="124">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Command}"
                                                Background="{DynamicResource MenuItemSelectedBackgroundBrush}"
                                                BorderBrush="{DynamicResource ButtonPrimaryBorderBrush}"
                                                menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Monitor.ExecuteOperationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Command}"
                                                FontSize="10.5"
                                                Style="{StaticResource IoCommandButton}"
                                                Width="112" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <Grid Visibility="{Binding CurrentScreen.Monitor.IsLaser, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="116" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="620" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="500" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="4,0,14,0">
                            <TextBlock Text="{Binding CurrentScreen.Monitor.HeadDeviceSelectorTitle}"
                                       Style="{StaticResource PanelTitle}"
                                       FontSize="18" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Selected"
                                           Style="{StaticResource MonitorSmallText}"
                                           FontSize="12" />
                                <TextBlock Text="{Binding CurrentScreen.Monitor.SelectedHeadDeviceName}"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Margin="10,-2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <ItemsControl Grid.Column="1"
                                      ItemsSource="{Binding CurrentScreen.Monitor.HeadSelectRows}"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Monitor.SelectHeadDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="{Binding BackgroundBrush}"
                                            BorderBrush="{Binding BorderBrush}"
                                            BorderThickness="1"
                                            Height="58"
                                            Margin="4,0"
                                            Padding="0"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="Stretch" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid Margin="8,6,8,6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="3" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding HeadName}"
                                                       Foreground="{Binding TextBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <Ellipse Grid.Column="1"
                                                     Width="9"
                                                     Height="9"
                                                     Fill="{Binding StateBrush}"
                                                     VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="1"
                                                       Grid.ColumnSpan="2"
                                                       Text="{Binding State}"
                                                       Foreground="{Binding StateBrush}"
                                                       FontSize="9.5"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Margin="0,2,0,0" />
                                            <Border Grid.Row="2"
                                                    Grid.ColumnSpan="2"
                                                    Background="{Binding StateBrush}"
                                                    CornerRadius="2" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource PanelBorder}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="154" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Laser Control / Command"
                                   Style="{StaticResource PanelTitle}"
                                   FontSize="18" />

                        <ItemsControl Grid.Row="1"
                                      ItemsSource="{Binding CurrentScreen.Monitor.OperationButtons}"
                                      Margin="0,8,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Background="{Binding BackgroundBrush}"
                                            BorderBrush="{Binding BorderBrush}"
                                            menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Monitor.ExecuteOperationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Height="54"
                                            Margin="6,4"
                                            Padding="10,0"
                                            Style="{StaticResource MonitorActionButton}">
                                        <Grid HorizontalAlignment="Stretch">
                                            <TextBlock Text="{Binding Label}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       LineHeight="14" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Grid.Row="2" Margin="4,8,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.35*" />
                                <ColumnDefinition Width="132" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CURRENT"
                                       Style="{StaticResource MonitorSmallText}"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       Text="INPUT"
                                       Style="{StaticResource MonitorSmallText}"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2"
                                       Text="COMMAND"
                                       Style="{StaticResource MonitorSmallText}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                        </Grid>

                        <ScrollViewer Grid.Row="3"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl
                                      ItemsSource="{Binding CurrentScreen.Monitor.LaserControlRows}"
                                      Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4,0,4,8"
                                            Padding="8"
                                            Background="{DynamicResource GridBackgroundBrush}"
                                            BorderBrush="{DynamicResource PanelBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                    <Grid Height="58">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.35*" />
                                            <ColumnDefinition Width="132" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentLabel}"
                                                       Style="{StaticResource MonitorSmallText}"
                                                       FontSize="12" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding CurrentValue}"
                                                           Foreground="{Binding CurrentValueBrush}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding CurrentUnit}"
                                                           Margin="5,3,0,0"
                                                           Style="{StaticResource MonitorSmallText}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="62" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Height="30">
                                                <Button Content="{Binding Setting.Value}"
                                                        Click="OpenLaserSettingInput">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource MonitorInputButton}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanCommand}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Border Background="{DynamicResource GridBackgroundBrush}"
                                                        BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}"
                                                        BorderThickness="1"
                                                        Padding="10,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanCommand}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="-"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SetUnit}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource MonitorSmallText}" />
                                        </Grid>
                                        <Button Grid.Column="2"
                                                Height="38"
                                                Background="{Binding BackgroundBrush}"
                                                BorderBrush="{Binding BorderBrush}"
                                                menu:CButtonCommandBehavior.Command="{Binding DataContext.CurrentScreen.Monitor.ExecuteOperationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding CommandLabel}"
                                                IsEnabled="{Binding CanCommand}"
                                                Opacity="{Binding CommandOpacity}"
                                                Style="{StaticResource MonitorActionButton}"
                                                Margin="0">
                                            <TextBlock Text="{Binding CommandLabel}"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </Button>
                                    </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,12,0" Visibility="Collapsed">
